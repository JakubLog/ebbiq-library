{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*\\/[a-z0-9][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "exercise",
        "scheduler",
        "pattern",
        "theme"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "contentSchema": {
      "type": "string",
      "minLength": 1
    },
    "grading": {
      "type": "string",
      "enum": [
        "self",
        "exact",
        "exact-or-ai",
        "ai"
      ]
    },
    "modes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "light",
          "dark"
        ]
      }
    },
    "trust": {
      "type": "string",
      "enum": [
        "official",
        "community"
      ]
    }
  },
  "required": [
    "id",
    "version",
    "kind",
    "title",
    "trust"
  ],
  "additionalProperties": false
}
