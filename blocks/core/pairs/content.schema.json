{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "pairs": {
      "minItems": 3,
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "term": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "definition": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "itemId": {
            "description": "Optional: id of an active item of the same subject that this element practises (e.g. from add_items).",
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "term",
          "definition"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "pairs"
  ],
  "additionalProperties": false
}
